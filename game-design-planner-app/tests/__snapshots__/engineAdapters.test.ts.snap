exports[`Unity adapter output > keeps the generated C# stable 2`] = `
"// <auto-generated>
//   Generated by Game Design Planner (engine IR v9, Unity adapter v16) from “Cinderholm (example)”.
//   Do not edit: the next import overwrites this file. Add code in a partial class in another file.
