# Copy to .env.development.local (dev server) or set in the host for builds (git-ignored). Values for the local stack come from `npx supabase status`.
# Leave empty to run the app local-only (no accounts).
VITE_SUPABASE_URL=
# Publishable/anon key only. Never put the secret/service_role key in a VITE_ variable.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional Cloudflare Turnstile site key for the sign-in form.
VITE_TURNSTILE_SITE_KEY=
