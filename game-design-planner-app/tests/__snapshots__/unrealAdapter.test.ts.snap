"// Generated by Game Design Planner (engine IR v7, Unreal adapter v3) from “Cinderholm (example)”.
// Do not edit: the next export replaces this file.
#pragma once

#include "CoreMinimal.h"
#include "Engine/DataAsset.h"
#include "CinderholmExampleEnums.h"
#include "ItemDefinition.generated.h"

class UTexture2D;

/** Item. Records come from Items — Items & Crafting. ID prefix “item.”. Schema version 1. One asset per record, made by the planner’s editor scripts. */
UCLASS(BlueprintType)
class PLANNERGAME_API UItemDefinition : public UPrimaryDataAsset
{
	GENERATED_BODY()

public:
	/** The planner schema this type stands for. */
	static constexpr const TCHAR* SchemaId = TEXT("UgNzlgZV");
	static constexpr int32 SchemaVersion = 1;

	/** Stable ID from the planner. Never changes once released. */
	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Planner")
	FName Id;

	UPROPERTY(VisibleAnywhere, BlueprintReadOnly, Category = "Planner", AdvancedDisplay)
	FString PlannerId;

	/** Required. Planner type: string. */
	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Planner|Item")
	FString DisplayName;

	/** Required. Planner type: Sprite. */
	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Planner|Item")
	TSoftObjectPtr<UTexture2D> Icon;

	/** Required. Planner type: enum. */
	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Planner|Item")
	ERarity Rarity = static_cast<ERarity>(0);

	/** Required. Planner type: int. */
	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Planner|Item")
	int32 Value = 0;

	/** Required. Planner type: int. */
	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Planner|Item")
	int32 StackSize = 0;

	/** Optional. Planner type: string[]. */
	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Planner|Item")
	TArray<FString> Tags;

	/** Optional. Planner type: text. */
	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Planner|Item")
	FString Description;
};
"
`;

