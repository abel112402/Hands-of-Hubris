using UnityEngine;

namespace CinderholmExample.Data
{
    /// <summary>Formulas from the planner. Mathf.Round rounds halves to even; the planner rounds them up.</summary>
    public static class Formulas
    {
        /// <summary>Health regen per second (Player Character › Other formulas).</summary>
        /// <remarks>Planner: base + level * perLevel. Sample: base = 0.5, level = 10, perLevel = 0.05.</remarks>
        public static float HealthRegenPerSecond(float @base, float level, float perLevel) => @base + level * perLevel;

        /// <summary>Mana pool (Player Character › Other formulas).</summary>
        /// <remarks>Planner: 50 + level * 8 + mana * 4. Sample: level = 10, mana = 6.</remarks>
        public static float ManaPool(float level, float mana) => 50f + level * 8f + mana * 4f;

        /// <summary>Enemy HP by biome stage (Combat, Enemies &amp; Bosses › Other formulas).</summary>
        /// <remarks>Planner: baseHp * pow(1.6, stage). Sample: baseHp = 30, stage = 2.</remarks>
        public static float EnemyHpByBiomeStage(float baseHp, float stage) => baseHp * Mathf.Pow(1.6f, stage);

        /// <summary>Crit multiplier (Combat, Enemies &amp; Bosses › Other formulas).</summary>
        /// <remarks>Planner: 1 + critChance / 100 * (critDamage - 1). Sample: critChance = 10, critDamage = 1.5.</remarks>
        public static float CritMultiplier(float critChance, float critDamage) => 1f + critChance / 100f * (critDamage - 1f);

        /// <summary>Bulk discount (Trade &amp; Economy › Price formulas).</summary>
        /// <remarks>Planner: value * (1 - min(qty, 20) / 100). Sample: value = 40, qty = 10.</remarks>
        public static float BulkDiscount(float value, float qty) => value * (1f - Mathf.Min(qty, 20f) / 100f);

        /// <summary>Winter food premium (Trade &amp; Economy › Price formulas).</summary>
        /// <remarks>Planner: value * season. Sample: value = 4, season = 1.25.</remarks>
        public static float WinterFoodPremium(float value, float season) => value * season;
    }
}
"
