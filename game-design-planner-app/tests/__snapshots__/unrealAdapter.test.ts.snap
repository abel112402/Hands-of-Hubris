#pragma once

#include "CoreMinimal.h"
#include "Components/ActorComponent.h"
#include "Classes/Damageable.h"
#include "HealthBase.generated.h"


/** Generated part of Health: Hit points, regeneration and death for the player and creatures. Your code: UHealth in Classes/GameplayPlayer/Health.h and .cpp. */
UCLASS(Abstract, BlueprintType)
class PLANNERGAME_API UHealthBase : public UActorComponent, public IDamageable
{
	GENERATED_BODY()

public:
	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Planner|Health")
	float Max = 0.f;
	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Planner|Health")
	float Current = 0.f;
	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Planner|Health")
	float RegenPerSecond = 0.f;

	// Written in your UHealth (Classes/GameplayPlayer/Health.cpp).
	virtual float TakeDamage(float Amount) PURE_VIRTUAL(UHealthBase::TakeDamage, return {};);
	virtual void Die() PURE_VIRTUAL(UHealthBase::Die, );
};
"
`;

