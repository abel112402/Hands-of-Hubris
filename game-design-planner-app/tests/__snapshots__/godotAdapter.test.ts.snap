exports[`Godot adapter output > keeps the generated GDScript stable 2`] = `
"# <auto-generated>
#   Generated by Game Design Planner (engine IR v6, Godot adapter v3) from “Cinderholm (example)”.
#   Do not edit: the next export replaces this file.
# </auto-generated>
class_name RecipeRecord
extends RefCounted
## Recipe. Records come from Recipes — Items & Crafting. ID prefix “rcp.”. Schema version 1.
## Read a record with from_dict (a JSON object from Data/, or a CSV row as a Dictionary).

## The planner schema this type stands for; the planner addon finds the type by it.
const SCHEMA_ID := "0Dx8qXVn"
const SCHEMA_VERSION := 1
## Planner field name → property name, for the importer.
const PLANNER_FIELDS := { "inputs": "inputs", "output": "output", "seconds": "seconds", "station": "station" }

## Stable ID from the planner. Never changes once released.
var id: String
var planner_id: String

## Required. Planner type: Item[]. Item ID.
var inputs: Array[String]

## Required. Planner type: Item. Item ID.
var output: String

## Required. Planner type: float.
var seconds: float

## Required. Planner type: Building. Building ID.
var station: String


static func from_dict(d: Dictionary) -> RecipeRecord:
	var r := RecipeRecord.new()
	r.id = CinderholmExampleValues.to_text(d.get("id"))
	r.planner_id = CinderholmExampleValues.to_text(d.get("plannerId"))
	r.inputs.assign(CinderholmExampleValues.to_list(d.get("inputs")))
	r.output = CinderholmExampleValues.to_text(d.get("output"))
	r.seconds = CinderholmExampleValues.to_float(d.get("seconds"))
	r.station = CinderholmExampleValues.to_text(d.get("station"))
	return r
"
`;

