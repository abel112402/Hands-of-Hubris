          "changeRules": "Main quests and certain diplomatic actions change the relationships. Supporting one group might counts as aggression towards another."
        },
        "factions": [
          {
            "id": "G2DMapbB",
            "name": "Iron Vanguard",
            "color": "#8B0000",
            "history": "Forged in the crucible of the industrial wars, the Vanguard believes only strict military order can save humanity from hubris.",
            "goals": "Establish absolute martial law across all biomes and eradicate magical research.",
            "capital": "Ironhold Citadel",
            "capitalDescription": "A bleak fortress of steel and smog. Offers heavy armor crafting and weapons trade, but strictly outlaws arcane items.",
            "playstyle": "Heavy melee combat, defense structures, and anti-magic tech.",
            "unlockConditions": "Complete the military escort questline and side with their commander in chapter 2.",
            "_ai": {
              "provider": "gemini",
              "model": "gemini-3.5-flash-lite",
              "at": "2026-11-03T18:23:10.698Z"
            }
          },
          {
            "id": "KxEqohPJ",
            "name": "Astral Conclave",
            "color": "#4B0082",
            "history": "Scholars and mystics who study the celestial anomalies that caused the current world crisis.",
            "goals": "Unlock the secrets of the cosmos and ascend humanity to a higher plane of existence.",
            "capital": "Stargazer Spire",
            "capitalDescription": "A towering white marble academy floating above the clouds. Offers arcane tomes, spellcrafting services, and stargazing quests.",
            "playstyle": "Ranged spellcasting, teleportation utilities, and high risk-reward mechanics.",
            "unlockConditions": "Deliver three rare star fragments and pass the Council's trial of intellect.",
            "_ai": {
              "provider": "gemini",
              "model": "gemini-3.5-flash-lite",
              "at": "2026-11-03T18:23:10.698Z"
            }
          },
          {
            "id": "LVUGgBjx",
            "name": "Verdant Syndicate",
            "color": "#228B22",
            "history": "A coalition of druids, hunters, and outcasts who protect the deep forests from both industrial and magical pollution.",
            "goals": "Restore the natural biomes to their pristine state and push civilization back to the borders.",
            "capital": "Heartwood",
            "capitalDescription": "A sprawling settlement integrated into giant ancient trees. Offers herbalism, poisons, beast taming, and wilderness survival gear.",
            "playstyle": "Agile skirmishing, stealth, poison effects, and companion synergies.",
            "unlockConditions": "Defend the sacred grove from Iron Vanguard raids and earn the trust of the Elder Druid.",
            "_ai": {
              "provider": "gemini",
              "model": "gemini-3.5-flash-lite",
              "at": "2026-11-03T18:23:10.698Z"
            }
          },
          {
            "id": "W7MkyuLk",
            "name": "Guild of the Gilded Coin",
            "color": "#FFD700",
            "history": "Merchant lords and smugglers who turned economic chaos into a sprawling commercial empire.",
            "goals": "Control all major trade routes, monopolize rare resources, and influence politics through sheer wealth.",
            "capital": "Port Aurelia",
            "capitalDescription": "A bustling coastal harbor filled with bustling markets and luxury inns. Offers the best general stores, black market goods, and mercenary contracts.",
            "playstyle": "Economy manipulation, bribery, hiring mercenaries, and utility gadgets.",
            "unlockConditions": "Amass a fortune of 10,000 gold and complete a high-risk smuggling mission.",
            "_ai": {
