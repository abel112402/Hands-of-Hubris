{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "hoh-engine"
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "engine": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "unity",
            "godot",
            "unreal"
          ]
        },
        "adapterVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "adapterVersion"
      ],
      "additionalProperties": false
    },
    "generator": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "app",
        "version"
      ],
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "exportedAt": {
      "type": "string"
    },
    "schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "enum": [
              "native",
              "json",
              "csv"
            ]
          },
          "idPrefix": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "records": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "data": {
            "type": "string"
          },
          "load": {
            "type": "object",
            "properties": {
              "group": {
                "type": "string"
              },
              "strategy": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "group",
              "strategy"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "format",
          "idPrefix",
          "version",
          "records",
          "data"
        ],
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "records": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "enums": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "formulas": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "strings": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "maps": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "records",
        "enums",
        "formulas",
        "strings",
        "maps"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "hash"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "v",
    "engine",
    "generator",
    "project",
    "exportedAt",
    "schemas",
    "counts",
    "files"
  ],
  "additionalProperties": false
}
